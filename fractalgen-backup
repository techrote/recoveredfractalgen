void normalize(double& x, double& y) noexcept {
    const double length_squared = x * x + y * y;
    if (length_squared <= 1.0e-24) {
        x = 1.0;
        y = 0.0;
        return;
    }
    const double inverse = 1.0 / std::sqrt(length_squared);
    x *= inverse;
    y *= inverse;
}

